---
import Base from '../layouts/Base.astro';
import Chrome from './Chrome.astro';
import content from '../data/content.json';
import { siteConfig } from '../data/siteConfig';
const { slug } = Astro.props;
const pg = content.pages[slug];
const home = slug === '/';
const fill = (s) => String(s ?? '').replace(/\{\{PHONE_DISPLAY\}\}/g, siteConfig.phoneDisplay).replace(/\{\{PHONE_HREF\}\}/g, siteConfig.phoneHref).replace(/\{\{BRAND\}\}/g, siteConfig.brand);
const url = siteConfig.origin + (home ? '/' : `/${slug}/`);
const modified = siteConfig.lastModified;
const crumbs = home ? null : { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.origin + '/' },
  { '@type': 'ListItem', position: 2, name: pg.bc || slug, item: url } ] };
const ld = [...pg.ld.map((j) => j.replace(/("@type":"WebPage"[^}]*?)"name"/, '$1"dateModified":"' + modified + '","name"')), ...(crumbs ? [JSON.stringify(crumbs)] : [])];
const tel = 'tel:' + siteConfig.phoneHref;
const heroImg = home ? siteConfig.heroImage : null;
const hasForm = !!pg.formHtml;
---
<Base title={pg.title} desc={pg.desc} canonical={url} ld={ld} hero={heroImg} modified={modified}>
<Chrome part="header" fill={fill} />
<main id="main">
  <section class={`hero ${home ? 'hero-home' : 'hero-page'}`}>
    {home && <img class="hero-bg" src={siteConfig.heroImage} alt={siteConfig.heroAlt} width="1808" height="1008" fetchpriority="high" decoding="async" />}
    {home && <div class="hero-shade"></div>}
    <div class="hero-in">
      <div class="hero-copy">
        {pg.bc && <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / {pg.bc}</nav>}
        {home && <p class="pill">{siteConfig.cityState}</p>}
        <h1 set:html={fill(pg.h1)} />
        <p class="hero-p" set:html={fill(pg.heroP)} />
        <div class="hero-actions">
          <a class="btn btn-primary" href={tel} aria-label={`Call ${siteConfig.brand} at ${siteConfig.phoneDisplay}`} data-phone>{siteConfig.phoneDisplay}</a>
          {hasForm ? <a class="btn btn-ghost" href="#contact">Request a Call</a> : <a class="btn btn-ghost" href="/">Back to home</a>}
        </div>
      </div>
    </div>
    {siteConfig.skin === 'bolt' && home && <svg class="wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80L60 70C120 60 240 40 360 35C480 30 600 40 720 45C840 50 960 50 1080 45C1200 40 1320 30 1380 25L1440 20V80H0Z" fill="#f8fafc" /></svg>}
  </section>
  {pg.intro && <section class="sec sec-lede"><div class="sec-in prose"><p set:html={fill(pg.intro)} /></div></section>}
  {pg.sections.map((s, i) => (
    <section class={`sec sec-${s.kind} sec-${i % 2 ? 'b' : 'a'}`}><div class="sec-in" set:html={fill(s.html)} /></section>
  ))}
  {pg.faq && (
    <section class="sec sec-faq"><div class="sec-in">
      <h2 set:html={fill(pg.faqH2)} />
      <div class="faq">{pg.faq.map((f) => <details><summary set:html={fill(f.q)} /><p set:html={fill(f.a)} /></details>)}</div>
    </div></section>
  )}
  {hasForm && (
    <section class="sec contact" id="contact"><div class="sec-in contact-grid">
      <div class="contact-copy">
        <h2 set:html={fill(pg.contactH2)} />
        {pg.contactPs.map((p) => <p set:html={fill(p)} />)}
        <a class="btn btn-primary" href={tel} data-phone aria-label={`Call ${siteConfig.brand} at ${siteConfig.phoneDisplay}`}>{siteConfig.phoneDisplay}</a>
      </div>
      <div class="form-card" set:html={pg.formHtml} />
    </div></section>
  )}
</main>
<Chrome part="footer" fill={fill} />
</Base>
